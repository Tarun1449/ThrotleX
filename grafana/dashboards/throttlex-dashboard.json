{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "Rate Limiting & Traffic Metrics",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "drawStyle": "line", "lineInterpolation": "smooth" },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 2,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "title": "Rate Limiter Traffic: Allowed vs Blocked (429)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(throttlex_ratelimit_allowed_total[1m]) or vector(0)",
          "legendFormat": "Allowed Requests",
          "refId": "A"
        },
        {
          "expr": "rate(throttlex_ratelimit_blocked_total[1m]) or vector(0)",
          "legendFormat": "Blocked (429) Requests",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 30 }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 1 },
      "id": 3,
      "options": { "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Rate Limit Rejection %",
      "type": "gauge",
      "targets": [
        {
          "expr": "((rate(throttlex_ratelimit_blocked_total[1m]) or vector(0)) / ((rate(throttlex_ratelimit_allowed_total[1m]) or vector(0)) + (rate(throttlex_ratelimit_blocked_total[1m]) or vector(0)) + 0.00001)) * 100",
          "legendFormat": "Rejection Rate %",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" } }
      },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Bloom Filter Rejections (404 Blocked)",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(increase(throttlex_bloom_filter_rejected_total[1h])) or vector(0)",
          "legendFormat": "Rejections (Past Hour)",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 5,
      "title": "Distributed Caching & Redis Efficiency",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "drawStyle": "line", "lineInterpolation": "smooth" },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 6,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "title": "Redis Cache Hits vs Misses",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(cache_redis_hit_total[1m]) or vector(0)",
          "legendFormat": "Cache Hits ({{cache}})",
          "refId": "A"
        },
        {
          "expr": "rate(cache_redis_miss_total[1m]) or vector(0)",
          "legendFormat": "Cache Misses ({{cache}})",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "green", "value": 90 }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 10 },
      "id": 7,
      "options": { "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Redis Cache Hit Ratio %",
      "type": "gauge",
      "targets": [
        {
          "expr": "((sum(cache_redis_hit_total) or vector(0)) / ((sum(cache_redis_hit_total) or vector(0)) + (sum(cache_redis_miss_total) or vector(0)) + 0.00001)) * 100",
          "legendFormat": "Hit Ratio %",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" } }
      },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 10 },
      "id": 8,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Outage Resilience: Caffeine RAM & DB Fallbacks",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(cache_caffeine_fallback_total[1m])) or vector(0)",
          "legendFormat": "L1 Caffeine RAM Rescues (req/s)",
          "refId": "A"
        },
        {
          "expr": "sum(rate(cache_db_fallback_total[1m])) or vector(0)",
          "legendFormat": "True PostgreSQL Queries (req/s)",
          "refId": "B"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 9,
      "title": "Circuit Breakers & System Resilience",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" } }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "id": 10,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "title": "Resilience4j Circuit Breaker State (redisRateLimiter)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "resilience4j_circuitbreaker_state or vector(0)",
          "legendFormat": "{{name}} state (0=closed, 1=open, 2=half_open)",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "bytes" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "id": 11,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "title": "JVM Heap Memory & Virtual Threads",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})",
          "legendFormat": "Heap Used Total",
          "refId": "A"
        },
        {
          "expr": "sum(jvm_threads_live_threads)",
          "legendFormat": "Live Threads Count",
          "refId": "B"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["throttlex", "rate-limiting", "observability"],
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s", "1m"] },
  "timezone": "browser",
  "title": "ThrottleX Engine & Resiliency Dashboard",
  "uid": "throttlex-main-dashboard"
}
